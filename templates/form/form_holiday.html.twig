<div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div>
        {{ include('composants/date_picker.html.twig', {
            label: 'Date du jour férié',
            type: 'date',
            value: HolidayFormType.date.vars.value ? HolidayFormType.date.vars.value|date('Y-m-d') : '',
            name: HolidayFormType.date.vars.full_name,
            with_time: false,
            required: true
        }) }}
        <div class="mt-1 text-sm text-red-500">
            {{ form_errors(HolidayFormType.date) }}
        </div>
    </div>

    <div>
        {{ include('composants/input_text.html.twig', {
            label: 'Nom du jour férié',
            placeholder: 'Ex: Noël, Lundi de Pâques...',
            value: HolidayFormType.name.vars.value,
            name: HolidayFormType.name.vars.full_name,
            required: true
        }) }}
        <div class="mt-1 text-sm text-red-500">
            {{ form_errors(HolidayFormType.name) }}
        </div>
    </div>

</div>

