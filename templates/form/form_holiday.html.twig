{% set labelStyle = "text-[#1F384C] font-medium mb-2 block text-base" %}
{% set inputBase = "border border-[#B4B4B4] rounded-lg w-full h-12 bg-white focus:border-[#2A7DE3] focus:outline-none text-[#1F384C] font-light px-4 transition-all" %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div class="form-control w-full">
        {{ form_label(HolidayFormType.date, null, {'label_attr': {'class': labelStyle}}) }}

        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#B4B4B4]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
            </div>
            {{ form_widget(HolidayFormType.date, { 'attr': {'class': 'input pl-12 ' ~ inputBase} }) }}
        </div>
        {{ form_errors(HolidayFormType.date) }}
    </div>

    <div class="form-control w-full">
        {{ form_label(HolidayFormType.name, null, {'label_attr': {'class': labelStyle}}) }}

        <div class="relative">
            {{ form_widget(HolidayFormType.name, { 'attr': {'class': 'input !pl-4 ' ~ inputBase} }) }}
        </div>
        {{ form_errors(HolidayFormType.name) }}
    </div>

</div>

<style>
    label {
        color: #1F384C !important;
        opacity: 1 !important;
    }
</style>
