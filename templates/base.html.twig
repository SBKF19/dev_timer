<!DOCTYPE html>
<html>
	<head>
		<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>


	<body class="bg-white flex">
		<div class="w-72 sticky top-0 h-screen">
			{{ include('composants/sidebar.html.twig', { active_menu: '' }) }}
		</div>
		<main class="flex-1 flex flex-col min-h-screen">

			<div class="max-w-4xl w-full mx-auto mt-4 px-4 space-y-2">
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div role="alert" class="alert {{ label == 'error' ? 'alert-error' : 'alert-success' }} shadow-lg mb-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewbox="0 0 24 24">
								{% if label == 'error' %}
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								{% else %}
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
								{% endif %}
							</svg>
							<span>{{ message }}</span>
						</div>
					{% endfor %}
				{% endfor %}
			</div>

			<div class="p-4"> {% block body %}{% endblock %}
				</div>
			</main>
		</body>
	</html>
</body></html></html></html>
