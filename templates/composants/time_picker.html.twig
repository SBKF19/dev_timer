<div class="inline-block w-full max-w-sm {{ class|default('') }}">
    {# Label #}
    <div class="mb-1 text-[15px] font-normal text-gray-500">
        {{ label|default('Heure') }}
        {% if required|default(false) %}
            <span class="text-gray-500 font-light"> - champ obligatoire</span>
        {% endif %}
    </div>

    <div class="relative">
        <input 
            type="time" 
            name="{{ name|default('') }}"
            id="{{ id|default('') }}"
            class="block w-full pl-4 pr-3 py-3 border border-black rounded-xl bg-white text-gray-900 text-lg focus:outline-none focus:ring-2 focus:ring-blue-500" 
            {% if value is defined %} value="{{ value }}" {% endif %}
            {% if attr is defined %}{% for key, val in attr %} {{ key }}="{{ val }}" {% endfor %}{% endif %}
        />
    </div>

    {# Gestion des erreurs #}
    {% if error is defined and error|length > 0 %}
        <div class="text-red-500 text-sm mt-2">
            {% for err in error %}
                <div>{{ err.message }}</div>
            {% endfor %}
        </div>
    {% endif %}
</div>