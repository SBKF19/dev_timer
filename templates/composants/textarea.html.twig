<div class="inline-block w-full {{ class|default('') }}">
    {# Label avec le style "champ obligatoire" #}
    {% if label is defined %}
        <div class="mb-1 text-[15px] font-normal text-gray-500">
            {{ label }}
            {% if required|default(false) %}
                <span class="text-gray-500 font-light">
                    - champ obligatoire</span>
            {% endif %}
        </div>
    {% endif %}

    <div class="relative">
        {# Icône à gauche (optionnelle, souvent une icône de texte ou d'alignement) #}
        {% if icon is defined %}
            <div class="absolute top-3 left-0 pl-3 flex items-start pointer-events-none text-slate-700">
                <i class="{{ icon }} h-5 w-5 mt-1"></i>
            </div>
        {% endif %}

        <textarea 
            id="{{ id|default(name|default('')) }}" 
            name="{{ name|default('') }}" 
            placeholder="{{ placeholder|default('') }}" 
            rows="{{ rows|default(4) }}"
            class="block w-full {{ icon is defined ? 'pl-10' : 'pl-4' }} pr-4 py-3 border {{ error is defined and error|length > 0 ? 'border-red-500' : 'border-black' }} rounded-xl bg-white text-gray-900 text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all placeholder:text-gray-400 resize-y"
            {% if required|default(false) %} required {% endif %}
            {% if attr is defined %}{% for key, val in attr %} {{ key }}="{{ val }}" {% endfor %}{% endif %}
        >{{ value|default('') }}</textarea>
    </div>

    {# Affichage de l'erreur #}
    {% if error is defined and error|length > 0 %}
        <div class="text-red-500 text-sm mt-1">
            {% for err in error %}
                <div>{{ err.message }}</div>
            {% endfor %}
        </div>
    {% endif %}
</div>