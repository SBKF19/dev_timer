<div class="flex items-center gap-3 {{ class|default('') }}">
	<label
		class="relative inline-flex items-center cursor-pointer">
		{# 1. L'input (obligatoirement en premier avec la classe peer) #}
		<input
		type="checkbox" name="{{ name|default('switch') }}" class="peer toggle toggle-lg checked:bg-[#1d3557] border-[#1d3557] [--tglbg:white] hover:bg-[#1d3557]/90" {% if checked|default(false) %} checked {% endif %} {% if attr is defined %} {% for key, val in attr %} {{ key }}="{{ val }}" {% endfor %} {% endif %}/>

		{# 2. Valeur pour le tri (invisible) #}
		<span class="sr-only">{{ checked|default(false) ? '1' : '0' }}</span>

		{# 3. Les labels en frères DIRECTS de l'input #}
		{% if label_on is defined or label_off is defined %}
			{# Texte si COCHÉ #}
			<span class="ml-3 hidden peer-checked:inline text-[17px] font-medium text-[#1d3557]">
				{{ label_on|default(label|default('Activé')) }}
			</span>

			{# Texte si DÉCOCHÉ #}
			<span class="ml-3 inline peer-checked:hidden text-[17px] font-medium text-[#1d3557]">
				{{ label_off|default(label|default('Inactif')) }}
			</span>
		{% elseif label is defined %}
			{# Texte fixe si pas de mode dynamique #}
			<span class="ml-3 text-[17px] font-medium text-[#1d3557]">
				{{ label }}
			</span>
		{% endif %}
	</label>
</div>
