<aside
	class="w-72 h-screen bg-white border-r border-gray-200 flex flex-col p-6 shadow-sm">
	{# Logo : Toujours visible #}
	<div class="mb-10 px-2">
		<img src="{{ asset('images/LOGO_EC2E.png') }}" alt="EC2E Logo" class="w-full max-w-[180px]">
	</div>

	{# On affiche le reste UNIQUEMENT si l'utilisateur est connecté #}
	{% if app.user %}
		{# Navigation #}
		<nav class="flex-1 space-y-2">
			{% if is_granted('ROLE_USER') %}
				{{ _self.nav_item(path('app_home'), 'Accueil', 'accueil.png', active_menu == 'accueil') }}
				{{ _self.nav_item(path('app_project'), 'Projets', 'projet.png', active_menu == 'projets') }}
				{{ _self.nav_item(path('hour_entry_list'), 'Saisie des heures', 'saisie.png', active_menu == 'timer') }}
				{{ _self.nav_item(path('reporting_global_list'), 'Reporting Global', 'reporting.png', active_menu == 'reporting') }}
			{% endif %}

			<hr class="my-4 border-gray-100">

			{% if is_granted('ROLE_RESPONSABLE') %}
				<div class="text-xs font-semibold text-gray-400 uppercase px-4 mb-2">Administration</div>
				{{ _self.nav_item(path('user_list'), 'Gestion des comptes', 'gestion.png') }}
				{{ _self.nav_item(path('app_schedule'), 'Horaires', 'horraire.png') }}
				{{ _self.nav_item(path('app_reminder_index'), 'Rappel email', 'rappel.png') }}
				{{ _self.nav_item(path('app_holiday'), 'Jours fériés', 'jourferie.png') }}
				{{ _self.nav_item(path('manager_hour_entry_list'), 'Corrections', 'correction.png') }}
			{% endif %}
		</nav>

		{# Profil Utilisateur avec Dropdown (Visible seulement si connecté) #}
		<div class="mt-auto pt-6 border-t border-gray-100 relative" x-data="{ open: false }">
			<div @click="open = !open" class="flex items-center gap-3 px-2 cursor-pointer group hover:bg-gray-50 p-2 rounded-xl transition-all">
				<div class="avatar">
					<div class="w-12 rounded-full ring ring-offset-2 ring-gray-100">
						<img src="{{ app.user.avatarUrl|default(asset('images/default_avatar.jpg')) }}" alt="Avatar"/>
					</div>
				</div>
				<div class="flex flex-col flex-1 truncate">
					<div class="flex items-center justify-between font-semibold text-gray-800 group-hover:text-blue-600 transition-colors">
						<span class="truncate">{{ app.user.firstName }}
							{{ app.user.lastName }}</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-200" :class="open ? 'rotate-180' : ''" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
						</svg>
					</div>
					<span class="text-xs text-gray-500">
						{{ is_granted('ROLE_RESPONSABLE') ? 'Manager' : 'Développeur' }}
					</span>
				</div>
			</div>

			{# Menu Déroulant #}
			<div x-show="open" @click.away="open = false" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="transform opacity-0 scale-95" x-transition:enter-end="transform opacity-100 scale-100" class="absolute bottom-full left-0 w-full mb-2 bg-white border border-gray-200 rounded-xl shadow-lg py-2 z-50">

				<a href="{{ path('app_logout') }}" onclick="return confirm('Êtes-vous sûr de vouloir vous déconnecter ?')" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
					</svg>
					Déconnexion
				</a>
			</div>
		</div>
	{% endif %}
</aside>

{% macro nav_item(url, label, imageName, is_active) %}
	<a href="{{ url }}" class="flex items-center gap-4 px-4 py-3 rounded-xl transition-all font-medium {{ is_active ? 'bg-blue-50 text-blue-700 shadow-sm' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' }}">
		<img src="{{ asset('images/' ~ imageName) }}" alt="{{ label }}" class="w-5 h-5 object-contain">
		<span class="text-[15px]">{{ label }}</span>
	</a>
{% endmacro %}
