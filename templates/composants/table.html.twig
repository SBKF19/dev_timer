<div class="overflow-x-auto w-full border border-gray-200 rounded-xl shadow-sm">
	<table class="table w-full" data-controller="sort">
		<thead class="bg-gray-200">
			<tr>
				{% for column in columns %}
					<th class="text-black text-[15px] font-semibold py-4 uppercase tracking-wider cursor-pointer hover:bg-gray-300 transition-colors" data-action="click->sort#sortBy">
						<div class="flex items-center justify-between px-4">
							{{ column }}
							<span class="text-gray-400 text-xs">↕</span>
						</div>
					</th>
				{% endfor %}
			</tr>
		</thead>

		<tbody class="bg-white">
			{% for row in data %}
				<tr class="hover:bg-gray-50 border-b border-gray-100">
					{% for cell in row %}
						<td class="text-gray-700 py-4 px-4">{{ cell|raw }}</td>
					{% endfor %}
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
