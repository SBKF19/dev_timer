<div class="inline-block w-full max-w-sm {{ class|default('') }}">
    {# 1. Label #}
    {% if label is defined %}
        <div class="mb-1 text-[15px] font-normal text-gray-500">
            {{ label }}
            {% if required|default(false) %}
                <span class="text-gray-500 font-light">- champ obligatoire</span>
            {% endif %}
        </div>
    {% endif %}

    <div class="relative">
        {# 2. Icône #}
        {% if icon is defined %}
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-700">
                <i class="{{ icon }} h-5 w-5"></i>
            </div>
        {% endif %}

        {# 3. Input - On simplifie la condition de la bordure rouge #}
        {% set has_error = error is defined and error is not empty %}
        
        <input 
            type="{{ type|default('text') }}" 
            id="{{ id|default(name|default('')) }}" 
            name="{{ name|default('') }}" 
            placeholder="{{ placeholder|default('') }}" 
            value="{{ value|default('') }}"
            {% if required|default(false) %} required {% endif %}
            {% if attr is defined %}
                {% for key, val in attr %} {{ key }}="{{ val }}" {% endfor %}
            {% endif %}
            class="block w-full {{ icon is defined ? 'pl-10' : 'pl-4' }} pr-4 py-3 border {{ has_error ? 'border-red-500' : 'border-black' }} rounded-xl bg-white text-gray-900 text-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all placeholder:text-gray-400"
        />
    </div>

    {# 4. Affichage de l'erreur (Gère les objets d'erreur Symfony ET les simples chaînes de caractères) #}
    {% if has_error %}
        <p class="mt-1 text-sm text-red-600">
            {{ error is iterable ? error[0].message : error }}
        </p>
    {% endif %}
</div>