{% extends 'base.html.twig' %}

{% block title %}Gestion des horaires{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 p-8">
    <div class="max-w-6xl mx-auto">

        <div class="flex justify-between items-center mb-10">
            <h1 class="text-2xl font-bold text-[#1F384C]">Horaires de l’entreprise</h1>
            <a href="{{ path('app_schedule_add') }}" class="btn btn-primary bg-[#2A7DE3] border-none text-white normal-case px-6 hover:bg-[#18355F] rounded-lg">
                Ajouter des horaires
            </a>
        </div>

        <div class="bg-white rounded-lg border border-[#E3E3E3] shadow-sm overflow-hidden">

            <div class="p-4 border-b border-[#E3E3E3]">
                <h2 class="text-sm font-semibold text-[#475E80] italic ml-6">
                    Liste des horaires de l’entreprise
                </h2>
            </div>

            <div class="p-10">
                <div class="overflow-hidden rounded-xl border border-[#E3E3E3]">
                    <table class="table w-full text-center border-collapse">
                        <thead>
                            <tr class="bg-[#F9FAFB] text-[#1F384C]">
                                <th class="py-4 border-b border-r border-[#E3E3E3] font-medium text-base">Jour</th>
                                <th class="py-4 border-b border-r border-[#E3E3E3] font-medium text-base">Horaires de début de journée</th>
                                <th class="py-4 border-b border-r border-[#E3E3E3] font-medium text-base">Action</th>
                                <th class="py-4 border-b border-r border-[#E3E3E3] font-medium text-base">Horaires de fin de journée</th>
                                <th class="py-4 border-b border-[#E3E3E3] font-medium text-base">Action</th>
                            </tr>
                        </thead>
                        <tbody class="text-[#1F384C]">
                            {% set jours = {1: 'LUNDI', 2: 'MARDI', 3: 'MERCREDI', 4: 'JEUDI', 5: 'VENDREDI'} %}

                            {% for dayNumber, schedule in schedules %}
                                <tr class="hover:bg-gray-50 transition-colors">

                                    <td class="py-4 border-b border-r border-[#E3E3E3] font-medium uppercase text-sm">
                                        {{ jours[dayNumber] }}
                                    </td>

                                    <td class="py-4 border-b border-r border-[#E3E3E3] text-sm">
                                        {% if schedule[0] is defined and schedule[0].period == 'Matin' %}
                                            {{ schedule[0].startTime|date('H\\hi') }} - {{ schedule[0].endTime|date('H\\hi') }}
                                        {% else %}
                                            /
                                        {% endif %}
                                    </td>

                                    <td class="py-4 border-b border-r border-[#E3E3E3]">
                                        <div class="flex flex-row justify-center items-center gap-4">
                                            {% if schedule[0] is defined and schedule[0].period == 'Matin' %}
                                                <a href="{{ path('app_schedule_edit', {'id': schedule[0].id}) }}" title="Modifier">
                                                    <img src="{{ asset('images/modify_icone.png') }}" class="w-5 h-5">
                                                </a>
                                                <form method="post" action="{{ path('app_schedule_delete', {'id': schedule[0].id}) }}" onsubmit="return confirm('Supprimer ?');" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ schedule[0].id) }}">
                                                    <button type="submit" class="align-middle">
                                                        <img src="{{ asset('images/remove_icone.png') }}" alt="Supprimer" class="w-5 h-5 object-contain">
                                                    </button>
                                                </form>
                                            {% else %}/{% endif %}
                                        </div>
                                    </td>

                                    <td class="py-4 border-b border-r border-[#E3E3E3] text-sm">

                                        {% set aprem = null %}
                                        {% if schedule[0] is defined and schedule[0].period == 'Après-midi' %}{% set aprem = schedule[0] %}{% endif %}
                                        {% if schedule[1] is defined and schedule[1].period == 'Après-midi' %}{% set aprem = schedule[1] %}{% endif %}

                                        {% if aprem %}
                                            {{ aprem.startTime|date('H\\hi') }} - {{ aprem.endTime|date('H\\hi') }}
                                        {% else %}
                                            /
                                        {% endif %}
                                    </td>

                                    <td class="py-4 border-b border-r border-[#E3E3E3] text-sm">
                                        <div class="flex flex-row justify-center items-center gap-4">
                                            {% if aprem is defined and aprem %}
                                                <a href="{{ path('app_schedule_edit', {'id': aprem.id}) }}" title="Modifier">
                                                    <img src="{{ asset('images/modify_icone.png') }}" class="w-5 h-5">
                                                </a>
                                                <form method="post" action="{{ path('app_schedule_delete', {'id': aprem.id}) }}" onsubmit="return confirm('Supprimer ?');" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ aprem.id) }}">
                                                    <button type="submit" class="align-middle">
                                                        <img src="{{ asset('images/remove_icone.png') }}" alt="Supprimer" class="w-5 h-5 object-contain">
                                                    </button>
                                                </form>
                                            {% else %}
                                                /
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
