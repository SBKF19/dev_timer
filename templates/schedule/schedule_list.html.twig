{% extends 'base.html.twig' %}

{% block title %}Gestion des horaires{% endblock %}

{% block body %}
    <div class="container mx-auto p-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Horaires de l’entreprise</h1>
            {% include 'composants/button.html.twig' with {
                href: path('app_schedule_add'),
                label: '+ Ajouter des horaires',
                type: 'confirmer',
                class: 'shadow-sm'
            } %}
        </div>

        <div class="overflow-x-auto w-full border border-gray-200 rounded-xl shadow-sm">
            <table class="table w-full text-left border-collapse">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider">Jour</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider">Matinée</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider w-24">Action</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider">Après-midi</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider w-24">Action</th>
                    </tr>
                </thead>

                <tbody class="bg-white">
                    {% set jours = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi'} %}

                    {% for dayNumber, schedule in schedules %}
                        <tr class="hover:bg-gray-50 transition-colors border-b border-gray-100 last:border-none">
                            
                            <td class="text-gray-900 font-medium py-4 px-4">
                                {{ jours[dayNumber] }}
                            </td>

                            <td class="text-gray-700 py-4 px-4">
                                {% if schedule[0] is defined and schedule[0].period == 'Matin' %}
                                    {{ schedule[0].startTime|date('H\\hi') }} - {{ schedule[0].endTime|date('H\\hi') }}
                                {% else %}<span class="text-gray-300">/</span>{% endif %}
                            </td>

                            <td class="py-4 px-4">
                                {% if schedule[0] is defined and schedule[0].period == 'Matin' %}
                                    <a href="{{ path('app_schedule_edit', {id: schedule[0].id}) }}" 
                                       class="inline-flex items-center text-gray-400 hover:text-blue-600 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                {% else %}<span class="text-gray-300">/</span>{% endif %}
                            </td>

                            <td class="text-gray-700 py-4 px-4">
                                {% set aprem = null %}
                                {% if schedule[0] is defined and schedule[0].period == 'Après-midi' %}{% set aprem = schedule[0] %}{% endif %}
                                {% if schedule[1] is defined and schedule[1].period == 'Après-midi' %}{% set aprem = schedule[1] %}{% endif %}

                                {% if aprem %}
                                    {{ aprem.startTime|date('H\\hi') }} - {{ aprem.endTime|date('H\\hi') }}
                                {% else %}<span class="text-gray-300">/</span>{% endif %}
                            </td>

                            <td class="py-4 px-4">
                                {% if aprem %}
                                    <a href="{{ path('app_schedule_edit', {id: aprem.id}) }}" 
                                       class="inline-flex items-center text-gray-400 hover:text-blue-600 transition-colors">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                {% else %}<span class="text-gray-300">/</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
{% endblock %}