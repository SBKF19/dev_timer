{% extends 'base.html.twig' %}

{% block title %}Calendrier des saisies
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/calendar.css') }}">
{% endblock %}

{% block body %}
	<div
		class="p-6 mx-auto">
		{# En-tête avec daisyUI #}
		<div class="flex flex-col md:flex-row justify-between mb-8 gap-4">
			<div>
				<h1 class="text-2xl font-bold text-gray-800">Calendrier des saisies</h1>
			</div>
			<div class="flex gap-4">
				<div class="bg-base-100 border border-base-200 shadow-sm px-6 py-3 rounded-2xl text-center">
					<div class="text-xs uppercase tracking-wider font-bold text-gray-400">Heures saisies</div>
					<div id="stat-saisie" class="text-2xl font-black text-blue-600">0h00</div>
				</div>
				<div class="bg-base-100 border border-base-200 shadow-sm px-6 py-3 rounded-2xl text-center">
					<div class="text-xs uppercase tracking-wider font-bold text-gray-400">Heures restantes</div>
					<div id="stat-restant" class="text-2xl font-black text-orange-500">0h00</div>
				</div>
			</div>
		</div>
	</div>

	{# Conteneur du calendrier (Card daisyUI) #}
	<div class="card bg-base-100 shadow-xl border border-base-200">
		<div class="card-body p-4 md:p-8">
			<div id='calendar' class="min-h-[600px]" data-events-url="{{ path('hour_entry_events') }}" data-add-url="{{ path('hour_entry_add') }}" data-edit-url="{{ path('hour_entry_edit', {'id': 'PLACEHOLDER'}) }}" data-stats-url="{{ path('hour_entry_stats') }}" data-business-hours="{{ businessHours|json_encode }}" data-min-time="{{ minTime }}" data-max-time="{{ maxTime }}"></div>
		</div>
	</div>
</div>{% endblock %}{% block javascripts %}
{{ parent() }}
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
<script src="{{ asset('js/calendar-init.js') }}"></script>{% endblock %}
