{# templates/reminder/new.html.twig #}
{% extends 'base.html.twig' %}

{% set jours_items = [
    {id: 1, label: 'Lundi'}, {id: 2, label: 'Mardi'}, {id: 3, label: 'Mercredi'},
    {id: 4, label: 'Jeudi'}, {id: 5, label: 'Vendredi'}, {id: 6, label: 'Samedi'}, {id: 7, label: 'Dimanche'}
] %}

{% block body %}
	<div class="flex justify-center items-center min-h-screen bg-gray-50">
		<div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 w-full max-w-sm">
			<h1 class="text-[22px] font-bold text-[#1d3557] mb-6">Ajout de rappel</h1>

			{{ form_start(form) }}
			<div
				class="space-y-5">
				{# 1. Sélection du Jour (Composant Select Multi en mode unique) #}
				{% include 'composants/select_multi.html.twig' with {
                    'label': 'Jour de la semaine',
                    'name': form.send_day.vars.full_name,
                    'placeholder': 'Choisir un jour',
                    'items': jours_items,
                    'multiple': false,
                    'required': true
                } %}

				{# 2. Sélection de l'Heure (Composant Time Picker) #}
				{% include 'composants/time_picker.html.twig' with {
                    'label': 'Heure - Champs obligatoire',
                    'name': form.send_time.vars.full_name,
                    'required': true,
                    'icon': 'fas fa-calendar-alt'
                } %}

				{# 3. Statut (Composant Switch) #}
				{% include 'composants/switch.html.twig' with {
                'label': 'Rappel actif',
                'label_off': 'Inactif',
                'name': form.is_active.vars.full_name,
                'checked': false
            } %}
				{{ form_widget(form._token) }}
				{# 4. Boutons d'action #}
				<div class="flex gap-4 pt-4">
					<div class="flex-1">
						{% include 'composants/button.html.twig' with {
                            'label': 'Retour',
                            'href': path('app_reminder_index'),
                            'type': 'annuler',
                            'class': 'w-full py-3 rounded-xl'
                        } %}
					</div>
					<div class="flex-1">
						{% include 'composants/button.html.twig' with {
                            'label': 'Ajouter',
                            'type': 'confirmer',
                            'class': 'w-full py-3 rounded-xl'
                        } %}
					</div>
				</div>
			</div>
			{{ form_end(form, {'render_rest': false}) }}
		</div>
	</div>
{% endblock %}
