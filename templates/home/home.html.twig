{% extends 'base.html.twig' %}

{% block title %}Accueil - Statistiques{% endblock %}

{% block body %}
<div class="p-6 max-w-7xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-slate-800">Accueil</h1>
    </div>

    <div class="grid grid-cols-1 gap-10">
        
        {#  Graphique Heures par Projet #}
        <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-1 h-6 bg-blue-600 rounded-full"></div>
                <h2 class="text-xl font-bold text-gray-800">Heures de développement par projet</h2>
            </div>
            <div class="h-[400px] relative">
                {{ render_chart(projectChart) }}
            </div>
        </div>

        {#  Graphique Heures par Activité #}
        <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8 transition-all hover:shadow-md">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-1 h-6 bg-emerald-500 rounded-full"></div>
                <h2 class="text-xl font-bold text-gray-800">Heures saisies par activité</h2>
            </div>
            <div class="h-[400px] relative">
                {{ render_chart(activityChart) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}