{% extends 'base.html.twig' %}

{% block title %}Accueil - Statistiques{% endblock %}

{% block body %}
<div class="p-6 max-w-7xl mx-auto pb-20"> 
    
    <div>
        <h1 class="text-3xl font-bold text-slate-800">Accueil</h1>
    </div>

    {# Force l'espace avec style="..." si Tailwind est bloqué #}
    <div class="grid grid-cols-1 gap-y-12" style="margin-top: 80px;">
        
        <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-1.5 h-6 bg-blue-600 rounded-full"></div>
                <h2 class="text-xl font-bold text-gray-800 italic">Heures de développement par projet</h2>
            </div>
            <div class="h-[400px] relative">
                {{ render_chart(projectChart) }}
            </div>
        </div>

        <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-1.5 h-6 bg-emerald-500 rounded-full"></div>
                <h2 class="text-xl font-bold text-gray-800 italic">Heures saisies par activité</h2>
            </div>
            <div class="h-[400px] relative">
                {{ render_chart(activityChart) }}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            
            <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8 flex flex-col h-[480px]">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-1.5 h-6 bg-slate-300 rounded-full"></div>
                    <h2 class="text-xl font-bold text-slate-700 italic">État de complétion des heures</h2>
                </div>
                <div class="flex-grow flex items-center justify-center relative">
                    {% set pc = completionStats.percentage|default(0) %}
                    <div style="position: relative; width: 280px; height: 280px; display: flex; align-items: center; justify-content: center;">
                        <svg width="280" height="280" viewBox="0 0 256 256" style="transform: rotate(-90deg);">
                            <circle cx="128" cy="128" r="90" stroke="#f1f5f9" stroke-width="20" fill="transparent" />
                            <circle cx="128" cy="128" r="90" stroke="#94a3b8" stroke-width="20" fill="transparent" 
                                    stroke-dasharray="565" stroke-dashoffset="{{ 565 - (pc / 100) * 565 }}" 
                                    stroke-linecap="round" style="transition: stroke-dashoffset 1s ease-in-out;" />
                        </svg>
                        <div style="position: absolute; font-size: 4rem; font-weight: 700; color: #1e293b;">{{ pc }}%</div>
                    </div>
                </div>
            </div>

            <div class="bg-white shadow-sm border border-gray-100 rounded-[25px] p-8 flex flex-col h-[480px]">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-1.5 h-6 bg-slate-300 rounded-full"></div>
                    <h2 class="text-xl font-bold text-slate-700 italic">Saisie des heures</h2>
                </div>
                <div class="flex-grow flex items-center justify-center px-4">
                    {% set missing = completionStats.missingHours|default(0) %}
                    <div style="background-color: {{ missing > 0 ? '#e57373' : '#66BB6A' }}; border-radius: 30px; padding: 40px; width: 100%; max-width: 440px; display: flex; align-items: center; justify-content: space-between; color: white; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                        <div>
                            <div style="font-size: 5rem; font-weight: 800; line-height: 1;">{{ missing > 0 ? missing : '0' }}</div>
                            <div style="font-size: 1.25rem; font-weight: 500;">retards de saisie</div>
                        </div>
                        <div style="background-color: rgba(255,255,255,0.2); padding: 20px; border-radius: 20px;">
                            <svg xmlns="http://www.w3.org/2000/svg" style="width: 50px; height: 50px;" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2L1 21h22L12 2zm1 14h-2v-2h2v2zm0-4h-2V8h2v4z"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="mt-4 text-center">
                    <a href="{{ path('hour_entry_list') }}" class="text-slate-400 hover:text-slate-800 font-bold text-lg flex items-center justify-center gap-2 italic">
                        Voir <span>→</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}