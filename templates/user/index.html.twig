{% extends 'base.html.twig' %}

{% block title %}Gestion des comptes utilisateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('tableau_user.css') }}">
{% endblock %}

{% block body %}
{# 1. Préparer la liste des utilisateurs #}
{% set userItems = [] %}
{% for u in allUsers %}
    {% set userItems = userItems|merge([{ id: u.id, label: u.lastname|upper ~ ' ' ~ u.firstname }]) %}
{% endfor %}

{# 2. Préparer la liste des statuts #}
{% set statusItems = [
    { id: '1', label: 'Actif' },
    { id: '0', label: 'Inactif' }
] %}

    <h1 class="">Gestion des comptes utilisateur</h1>

    {{ include('composants/button.html.twig', {type: 'confirmer', label: '+ Ajouter un utilisateur',href: path('user_add'),}) }}    

    <div class="card bg-light mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('user_list') }}" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            
            {# Recherche textuelle #}
            {{ include('composants/input_text.html.twig', {
                'label': 'Recherche',
                'placeholder': 'Nom, prénom, email...',
                'value': filters.search,
                'name': 'search'
            }) }}

            {# Sélecteur par Utilisateur #}
            {{ include('composants/select_multi.html.twig', {
                label: 'Développeur',
                name: 'user_id',
                placeholder: 'Sélectionner un développeur',
                items: userItems,
                multiple: false
            }) }}

            {# Sélecteur Statut #}
            {{ include('composants/select_multi.html.twig', {
                label: 'Statut',
                name: 'status',
                placeholder: 'Tous les statuts',
                items: statusItems,
                multiple: false
            }) }}

            {# Boutons #}
            <div class="flex gap-2">
                {{ include('composants/button.html.twig', {type: 'filtrer', label: 'Filtrer'}) }}
                {{ include('composants/button.html.twig', {
                    type: 'annuler', 
                    label: 'Réinitialiser',
                    href: path('user_list'),
                }) }}
                
            </div>

        </form>
    </div>
</div>
    <div id="users-table" class="scroll-mt-10">
    {# COMPTEUR DE RÉSULTATS #}
    <div class="mb-3 text-sm text-gray-600 font-semibold">
        Total des utilisateurs : {{ users.getTotalItemCount }}
    </div>

    {# --- PRÉPARATION POUR LE COMPOSANT TABLEAU --- #}
    {% set reqSort = app.request.query.get('sort') %}
    {% set currentSort = reqSort ?: 'u.lastname' %}
    {% set currentDir  = app.request.query.get('direction', 'asc')|lower %}

    {% set tableColumns = [
        knp_pagination_sortable(users, 'Nom ' ~ (currentSort in ['u.lastname', 'lastname'] ? (currentDir == 'asc' ? '▲' : '▼')), 'u.lastname'),
        knp_pagination_sortable(users, 'Prénom ' ~ (currentSort in ['u.firstname', 'firstname'] ? (currentDir == 'asc' ? '▲' : '▼')), 'u.firstname'),
        'Email',
        knp_pagination_sortable(users, 'Dernière connexion ' ~ (currentSort in ['u.last_login', 'last_login'] ? (currentDir == 'asc' ? '▲' : '▼')), 'u.last_login'),
        'Statut',
        'Rôle',
        knp_pagination_sortable(users, 'Embauche ' ~ (currentSort in ['u.hired_date', 'hired_date'] ? (currentDir == 'asc' ? '▲' : '▼')), 'u.hired_date'),
        knp_pagination_sortable(users, 'Fin contrat ' ~ (currentSort in ['u.contract_end_date', 'contract_end_date'] ? (currentDir == 'asc' ? '▲' : '▼')), 'u.contract_end_date'),
        'Couleur',
        'Action'
    ] %}

    {% set tableData = [] %}
    {% for user in users %}
        {% set row = [
            '<span class="font-medium">' ~ user.lastname|upper ~ '</span>',
            user.firstname,
            '<a href="mailto:' ~ user.email ~ '" class="text-blue-600 hover:underline">' ~ user.email ~ '</a>',
            user.lastLogin ? user.lastLogin|date('d/m/Y H:i') : '<span class="text-gray-400">Jamais</span>',
            user.status ? '<span class="badge bg-success">Actif</span>' : '<span class="badge bg-secondary">Inactif</span>',
            user.role ? '<span class="text-dark">' ~ user.role.label ~ '</span>' : '-',
            user.hiredDate ? user.hiredDate|date('d/m/Y') : '-',
            user.contractEndDate ? user.contractEndDate|date('d/m/Y') : '<span class="text-gray-400 italic">Non défini</span>',
            '<div class="flex items-center gap-2"><div class="w-4 h-4 rounded-full" style="background-color:' ~ user.color ~ '"></div><span style="color:' ~ user.color ~ '">' ~ user.color ~ '</span></div>',
            '<div class="flex gap-2">
                <a href="' ~ path('user_edit', {'id': user.id}) ~ '" class="btn btn-sm btn-outline-primary">Modifier</a>
                <form method="post" action="' ~ path('user_delete', {'id': user.id}) ~ '" onsubmit="return confirm(\'Êtes-vous sûr de vouloir archiver cet utilisateur ?\');" style="display:inline;">
                    <input type="hidden" name="_token" value="' ~ csrf_token('delete' ~ user.id) ~ '">
                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                </form>
            </div>'
        ] %}
        {% set tableData = tableData|merge([row]) %}
    {% endfor %}

    {# --- AFFICHAGE VIA LE COMPOSANT --- #}
    <div class="user-table-compact text-xs md:text-sm">
        {{ include('composants/table_data.html.twig', {
            'columns': tableColumns,
            'data': tableData
        }) }}
    </div>

    {# PAGINATION #}
    <div class="mt-4 flex justify-center">
        {{ knp_pagination_render(users) }}
    </div>
</div>

{% endblock %}