{% extends 'base.html.twig' %}

{% block title %}Gestion des jours fériés{% endblock %}

{% block body %}

    {% set yearItems = [] %}
    {% for year in years %}
        {% set yearItems = yearItems|merge([{
            id: year, 
            value: year, 
            label: year
        }]) %}
    {% endfor %}

    <div class="container mx-auto p-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Gestion des jours fériés</h1>
            {% include 'composants/button.html.twig' with {
                href: path('app_holiday_add'),
                label: '+ Ajouter un jour férié',
                type: 'confirmer',
                class: 'shadow-sm'
            } %}
        </div>

        {# SECTION FILTRES #}
        <div class="card bg-white p-6 shadow-sm border border-gray-100 rounded-2xl mb-8">
            <div class="flex items-center gap-2 mb-4 text-gray-700">
                <span class="font-bold uppercase tracking-wider text-xs">Filtres de recherche</span>
                <hr class="flex-grow border-gray-200">
            </div>
            <form method="get" action="{{ path('app_holiday') }}" class="flex flex-wrap md:flex-nowrap items-end gap-4">
                
                <div class="flex-grow">
                    {{ include('composants/select_multi.html.twig', {
                        label: 'Année',
                        name: 'year[]',
                        placeholder: 'Toutes les années',
                        items: yearItems,
                        value: current_years|join(','),
                        multiple: true
                    }) }}
                </div>
                
                <div class="flex gap-2">
                    {{ include('composants/button.html.twig', {type: 'filtrer', label: 'Actualiser'}) }}
                    {{ include('composants/button.html.twig', {
                            type: 'annuler', 
                            label: 'Réinitialiser',
                            href: path('app_holiday'),
                        }) }}
                </div>
            </form>
        </div>

        {# TABLEAU #}
        <div class="overflow-x-auto w-full border border-gray-200 rounded-xl shadow-sm bg-white">
            <table class="table w-full text-left border-collapse">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider">Date</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider">Nom</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider text-center">Année</th>
                        <th class="text-black text-[15px] font-semibold py-4 px-4 uppercase tracking-wider text-center">Actions</th>
                    </tr>
                </thead>

                <tbody class="bg-white">
                    {% set months = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

                    {% for year, holidays in groupedHolidays %}
                        {% for holiday in holidays %}
                            <tr class="hover:bg-gray-50 transition-colors {{ loop.last ? 'border-b border-gray-200' : '' }}">
                                
                                <td class="text-gray-900 font-medium py-4 px-4">
                                    {{ holiday.date|date('j') }} {{ months[holiday.date|date('n')] }}
                                </td>

                                <td class="text-gray-700 py-4 px-4">
                                    {{ holiday.name }}
                                </td>

                                {% if loop.first %}
                                    <td class="text-gray-900 font-bold py-4 px-4 text-center align-middle bg-gray-50/30" 
                                        rowspan="{{ holidays|length }}">
                                        {{ year }}
                                    </td>
                                {% endif %}

                                <td class="text-center py-4 px-4">
                                    <a href="{{ path('app_holiday_edit', {id: holiday.id}) }}" 
                                       class="inline-flex items-center justify-center text-gray-400 hover:text-blue-600 transition-colors" 
                                       title="Éditer le jour férié">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# PAGINATION #}
        <div class="flex justify-between items-center mt-6 px-4">
            <div class="text-sm text-gray-500 font-medium">
                Affichage de {{ pagination.getItemNumberPerPage * (pagination.currentPageNumber - 1) + 1 }} 
                à {{ pagination.getItemNumberPerPage * pagination.currentPageNumber }} 
                sur <span class="text-gray-900 font-bold">{{ pagination.totalItemCount }}</span> résultats
            </div>
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
{% endblock %}