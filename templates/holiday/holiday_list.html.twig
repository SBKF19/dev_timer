{% extends 'base.html.twig' %}

{% block body %}
<div class="p-12 bg-white min-h-screen font-sans">
    <div class="flex justify-between items-center mb-10">
        <h1 class="text-2xl font-bold text-[#1F384C]">Gestion des jours fériés</h1>
        <a href="{{ path('app_holiday_add') }}" class="btn btn-primary bg-[#2A7DE3] border-none text-white normal-case px-6 hover:bg-[#18355F] rounded-lg">
            Ajouter un jour férié
        </a>
    </div>

    <div class="border-b border-[#E3E3E3] mb-12">
        <h1 class="text-[#475E80] text-sm font-semibold italic pb-2 ml-4">Liste des jours fériés</h1>
    </div>

    <div class="max-w-6xl mx-auto">
        <div class="rounded-xl border border-[#D1D1D1] overflow-hidden">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="text-[#1F384C] bg-gray-50">
                        <th class="py-4 border-b border-r border-[#D1D1D1] font-bold w-1/4">Date</th>
                        <th class="py-4 border-b border-r border-[#D1D1D1] font-bold w-1/4">Nom</th>
                        <th class="py-4 border-b border-r border-[#D1D1D1] font-bold w-1/4">Année</th>
                        <th class="py-4 border-b border-[#D1D1D1] font-bold w-1/4">Action</th>
                    </tr>
                </thead>
                <tbody class="text-[#1F384C]">
                    {% set months = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

                    {% for year, holidays in groupedHolidays %}
                        {% for holiday in holidays %}
                            {% set isNewYear = loop.first %}
                            {% set isNotFirstRow = not (isNewYear and loop.parent.loop.first) %}

                            <tr class="text-center hover:bg-gray-50 transition-colors {{ isNewYear and isNotFirstRow ? 'border-t-2 border-t-[#D1D1D1]' : '' }}">
                                <td class="py-4 border-b border-r border-[#D1D1D1] text-sm">
                                    {{ holiday.date|date('j') }} {{ months[holiday.date|date('n')] }}
                                </td>

                                <td class="py-4 border-b border-r border-[#D1D1D1] text-sm">
                                    {{ holiday.name }}
                                </td>

                                {% if loop.first %}
                                    <td class="py-4 border-r border-[#D1D1D1] font-bold align-middle bg-white"
                                        rowspan="{{ holidays|length }}">
                                        {{ year }}
                                    </td>
                                {% endif %}

                                <td class="py-4 border-b border-[#D1D1D1]">
                                    <div class="flex justify-center items-center gap-4">
                                        <a href="{{ path('app_holiday_edit', {id: holiday.id}) }}" title="Modifier">
                                            <img src="{{ asset('images/modify_icone.png') }}" class="w-4 h-4 hover:scale-110 transition-transform">
                                        </a>
                                        <form method="post" action="{{ path('app_holiday_delete', {id: holiday.id}) }}" onsubmit="return confirm('Supprimer ce jour férié ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ holiday.id) }}">
                                            <button type="submit" title="Supprimer">
                                                <img src="{{ asset('images/remove_icone.png') }}" class="w-4 h-4 hover:scale-110 transition-transform">
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    tr:last-child td {
        border-bottom: none;
    }

    .border-t-2 td {
        border-top-width: 2px;
        border-top-color: #D1D1D1;
    }
</style>
{% endblock %}
