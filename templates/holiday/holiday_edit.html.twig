{% extends 'base.html.twig' %}

{% block title %}Modifier un jour férié{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] flex items-center justify-center p-4">
    <div class="w-full max-w-4xl bg-white border border-slate-200 rounded-2xl shadow-sm p-12">

        <header class="mb-10">
            <h1 class="text-slate-900 text-2xl font-bold mb-2">Gestion des jours fériés</h1>
            <h2 class="text-slate-500 text-lg font-semibold">Modification du jour férié</h2>
        </header>

        {{ form_start(HolidayFormType, { attr: { id: 'holiday_form_edit'} }) }}
            {{ include("form/form_holiday.html.twig") }}
        {{ form_end(HolidayFormType, {'render_rest': false}) }}

        <div class="flex flex-row justify-between items-center mt-12 gap-4">
            
            {# Bouton Retour #}
            <div class="flex-1">
                <a href="{{ path('app_holiday') }}">
                    {{ include('composants/button.html.twig', {
                        type: 'annuler', 
                        label: 'Retour'
                    }) }}
                </a>
            </div>

            {# Bouton Supprimer #}
            <div class="flex-1">
                <form method="post" action="{{ path('app_holiday_delete', {'id': holiday.id}) }}" onsubmit="return confirm('Supprimer ce jour férié ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_holiday') }}">
                    <button type="submit" class="w-full">
                        {{ include('composants/button.html.twig', {
                            type: 'effacer', 
                            label: 'Supprimer'
                        }) }}
                    </button>
                </form>
            </div>

            {# Bouton Modifier #}
            <div class="flex-1">
                <button type="submit" form="holiday_form_edit" class="w-full">
                    {{ include('composants/button.html.twig', {
                        type: 'confirmer', 
                        label: 'Modifier'
                    }) }}
                </button>
            </div>

        </div>
    </div>
</div>
{% endblock %}