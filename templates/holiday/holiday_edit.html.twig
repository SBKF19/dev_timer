{% extends 'base.html.twig' %}

{% block title %}Modifier un jour férié{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] flex items-center justify-center p-4">
    <div class="w-full max-w-4xl bg-white border border-slate-200 rounded-2xl shadow-sm p-12">

        <header class="mb-10">
            <h1 class="text-slate-900 text-2xl font-bold mb-2">Gestion des jours fériés</h1>
            <h2 class="text-slate-500 text-lg font-semibold">Modification du jour férié</h2>
        </header>

        {{ form_start(HolidayFormType, { attr: { id: 'holiday_form_edit'} }) }}
            {{ include("form/form_holiday.html.twig") }}
            {{ form_widget(HolidayFormType._token) }}
        {{ form_end(HolidayFormType, {'render_rest': false}) }}

        <div class="flex flex-row items-stretch mt-12 gap-4">
            
            <div class="flex-1">
                {{ include('composants/button.html.twig', {
                    href: path('app_holiday'),
                    type: 'annuler', 
                    label: 'Retour',
                    class: 'w-full h-12 flex items-center justify-center'
                }) }}
            </div>

            <div class="flex-1">
                <form method="post" action="{{ path('app_holiday_delete', {'id': holiday.id}) }}" 
                      onsubmit="return confirm('Supprimer ce jour férié ?');" 
                      class="h-full">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ holiday.id) }}">
                    {{ include('composants/button.html.twig', {
                        type: 'effacer', 
                        label: 'Supprimer',
                        class: 'w-full h-12'
                    }) }}
                </form>
            </div>

            <div class="flex-1">
                {{ include('composants/button.html.twig', {
                    label: 'Modifier',
                    type: 'confirmer',
                    class: 'w-full h-12',
                    attr: {
                        'form': 'holiday_form_edit',
                        'type': 'submit'
                    }
                }) }}
            </div>
        </div>

    </div>
</div>
{% endblock %}